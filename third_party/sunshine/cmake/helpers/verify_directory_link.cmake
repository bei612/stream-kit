# Verify the link itself: CMake REAL_PATH on Windows does not dereference
# directory junctions. READ_SYMLINK returns their NT-prefixed target instead.
function(VERIFY_DIRECTORY_LINK link expected)
    if(NOT IS_SYMLINK "${link}")
        message(FATAL_ERROR "Expected a directory link: ${link}")
    endif()
    file(READ_SYMLINK "${link}" target)
    if(WIN32)
        string(SUBSTRING "${target}" 0 4 prefix)
        if(prefix STREQUAL "\\??\\")
            string(SUBSTRING "${target}" 4 -1 target)
        endif()
    endif()
    get_filename_component(parent "${link}" DIRECTORY)
    file(REAL_PATH "${target}" actual BASE_DIRECTORY "${parent}")
    file(REAL_PATH "${expected}" wanted)
    if(WIN32)
        string(TOLOWER "${actual}" actual)
        string(TOLOWER "${wanted}" wanted)
    endif()
    if(NOT IS_DIRECTORY "${actual}" OR NOT actual STREQUAL wanted)
        message(FATAL_ERROR "Directory link does not reference the configured source assets: ${link}")
    endif()
endfunction()
