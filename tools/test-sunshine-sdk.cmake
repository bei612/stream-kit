# Validate dependency selection without linking or claiming a Linux runtime test.
cmake_minimum_required(VERSION 3.25)
get_filename_component(repo "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef fixture_id)
set(fixture "${repo}/.local/validation/cmake-build-sdk-contract-${fixture_id}")
set(sdk "${fixture}/sdk")
file(MAKE_DIRECTORY "${sdk}/include/libavcodec" "${sdk}/lib/pkgconfig" "${fixture}/project")
file(WRITE "${sdk}/include/libavcodec/avcodec.h" "/* Configuration-only fixture. */\n")
foreach(library avcodec swscale avutil cbs SvtAv1Enc x264 x265 va va-drm va-x11 vulkan osfixture)
    file(WRITE "${sdk}/lib/lib${library}.a" "")
endforeach()
file(WRITE "${sdk}/lib/libvulkan.so.1" "Configuration-only runtime fixture")
foreach(module libva libva-drm libva-x11 vulkan osfixture)
    string(REGEX REPLACE "^lib" "" library "${module}")
    set(private "")
    if(module STREQUAL "libva")
        set(private "Requires.private: osfixture\n")
    endif()
    file(WRITE "${sdk}/lib/pkgconfig/${module}.pc"
        "prefix=${sdk}\nlibdir=\${prefix}/lib\nincludedir=\${prefix}/include\nName: ${module}\nDescription: SDK contract fixture\nVersion: 1.0.0\n${private}Libs: -L\${libdir} -l${library}\nCflags: -I\${includedir}\n")
endforeach()
file(WRITE "${fixture}/project/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.25)
project(sdk_contract LANGUAGES NONE)
# Exercise Linux package-selection logic, not a cross-compiler or Linux ABI.
set(WIN32 FALSE)
set(UNIX TRUE)
set(APPLE FALSE)
set(FREEBSD FALSE)
set(FFMPEG_PREPARED_BINARIES "${SDK}")
include("${REPO}/third_party/sunshine/cmake/dependencies/ffmpeg.cmake")
get_target_property(dependencies PkgConfig::FFMPEG_NATIVE INTERFACE_LINK_LIBRARIES)
if(NOT dependencies MATCHES "osfixture")
    message(FATAL_ERROR "Static native dependencies were lost: ${dependencies}")
endif()
]=])
execute_process(COMMAND "${CMAKE_COMMAND}" -E env "PKG_CONFIG_PATH=${sdk}/lib/pkgconfig"
    "${CMAKE_COMMAND}" -G Ninja -S "${fixture}/project" -B "${fixture}/accepted" "-DSDK=${sdk}" "-DREPO=${repo}"
    RESULT_VARIABLE accepted OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT accepted EQUAL 0)
    message(FATAL_ERROR "Prepared SDK was rejected: ${output}${error}")
endif()
file(READ "${sdk}/lib/pkgconfig/libva.pc" foreign)
string(REPLACE "prefix=${sdk}" "prefix=${fixture}/foreign" foreign "${foreign}")
file(MAKE_DIRECTORY "${fixture}/foreign/lib/pkgconfig" "${fixture}/foreign/include")
file(WRITE "${fixture}/foreign/lib/pkgconfig/libva.pc" "${foreign}")
file(WRITE "${fixture}/foreign/lib/libva.a" "")
set(separator ":")
if(CMAKE_HOST_WIN32)
    set(separator ";")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env "PKG_CONFIG_PATH=${fixture}/foreign/lib/pkgconfig${separator}${sdk}/lib/pkgconfig"
    "${CMAKE_COMMAND}" -G Ninja -S "${fixture}/project" -B "${fixture}/rejected" "-DSDK=${sdk}" "-DREPO=${repo}"
    RESULT_VARIABLE rejected OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(rejected EQUAL 0 OR NOT error MATCHES "must come from the prepared FFmpeg SDK")
    message(FATAL_ERROR "Foreign native SDK was not rejected correctly: ${output}${error}")
endif()
# A pkg-config entry or static archive alone cannot satisfy the deployed loader.
file(RENAME "${sdk}/lib/libvulkan.so.1" "${sdk}/lib/runtime-held.so.1")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env "PKG_CONFIG_PATH=${sdk}/lib/pkgconfig"
    "${CMAKE_COMMAND}" -G Ninja -S "${fixture}/project" -B "${fixture}/missing-runtime" "-DSDK=${sdk}" "-DREPO=${repo}"
    RESULT_VARIABLE missing OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(missing EQUAL 0 OR NOT error MATCHES "missing source-built Vulkan runtime")
    message(FATAL_ERROR "Missing Vulkan runtime was not rejected correctly: ${output}${error}")
endif()
message(STATUS "SDK dependency selection and static closure passed; no Linux binaries were executed")
