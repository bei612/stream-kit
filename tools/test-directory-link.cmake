cmake_minimum_required(VERSION 3.25)
include("${CMAKE_CURRENT_LIST_DIR}/../third_party/sunshine/cmake/helpers/verify_directory_link.cmake")
if(DEFINED PROBE_LINK)
    VERIFY_DIRECTORY_LINK("${PROBE_LINK}" "${PROBE_EXPECTED}")
    return()
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(fixture "${CMAKE_CURRENT_LIST_DIR}/../.local/validation/directory-link-${suffix}")
get_filename_component(fixture "${fixture}" ABSOLUTE)
file(MAKE_DIRECTORY "${fixture}/source" "${fixture}/other")
if(WIN32)
    cmake_path(CONVERT "${fixture}/source" TO_NATIVE_PATH_LIST native_source)
    cmake_path(CONVERT "${fixture}/link" TO_NATIVE_PATH_LIST native_link)
    execute_process(COMMAND cmd.exe /c mklink /J "${native_link}" "${native_source}"
            COMMAND_ERROR_IS_FATAL ANY OUTPUT_QUIET)
else()
    file(CREATE_LINK "${fixture}/source" "${fixture}/link" SYMBOLIC)
endif()
VERIFY_DIRECTORY_LINK("${fixture}/link" "${fixture}/source")
foreach(candidate IN ITEMS link source)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DPROBE_LINK=${fixture}/${candidate}"
            "-DPROBE_EXPECTED=${fixture}/other" -P "${CMAKE_CURRENT_LIST_FILE}"
            RESULT_VARIABLE rejected OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(rejected EQUAL 0 OR NOT error MATCHES "directory link|Directory link")
        message(FATAL_ERROR "Invalid link was not rejected: ${output}${error}")
    endif()
endforeach()
message(STATUS "Directory links: valid target accepted; wrong target and ordinary directory rejected")
