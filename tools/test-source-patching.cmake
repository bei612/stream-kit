# Run with the same native toolchain as build-deps:
# cmake -P tools/test-source-patching.cmake
cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/../third_party/sunshine/third-party/build-deps/cmake/apply_git_patch.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../third_party/sunshine/third-party/build-deps/cmake/prepare_source_tree.cmake")

if(DEFINED REJECT_FIXTURE)
    APPLY_GIT_PATCH("${REJECT_FIXTURE}" "${REJECT_FIXTURE}/change.patch")
    return()
endif()

string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef test_id)
get_filename_component(fixture "${CMAKE_CURRENT_LIST_DIR}/../.local/validation/source-patch-${test_id}" ABSOLUTE)
file(MAKE_DIRECTORY "${fixture}")
file(WRITE "${fixture}/input.txt" "before\n")
file(WRITE "${fixture}/change.patch" "--- a/input.txt\n+++ b/input.txt\n@@ -1 +1 @@\n-before\n+after\n")

APPLY_GIT_PATCH("${fixture}" "${fixture}/change.patch")
file(READ "${fixture}/input.txt" actual)
if(NOT actual STREQUAL "after\n")
    message(FATAL_ERROR "A successful patch must change the generated source")
endif()
APPLY_GIT_PATCH("${fixture}" "${fixture}/change.patch")
file(READ "${fixture}/input.txt" actual)
if(NOT actual STREQUAL "after\n")
    message(FATAL_ERROR "Repeated patch application changed the result")
endif()

file(WRITE "${fixture}/input.txt" "unexpected source\n")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DREJECT_FIXTURE=${fixture}" -P "${CMAKE_CURRENT_LIST_FILE}"
        RESULT_VARIABLE rejected OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(rejected EQUAL 0 OR NOT error MATCHES "does not match its locked source")
    message(FATAL_ERROR "A mismatched patch was not rejected: ${output}${error}")
endif()
file(READ "${fixture}/input.txt" actual)
if(NOT actual STREQUAL "unexpected source\n")
    message(FATAL_ERROR "Rejected patch modified the generated source")
endif()
file(WRITE "${fixture}/input.txt" "after\n")
file(WRITE "${fixture}/second.txt" "before\n")
file(APPEND "${fixture}/change.patch" "--- a/second.txt\n+++ b/second.txt\n@@ -1 +1 @@\n-before\n+after\n")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DREJECT_FIXTURE=${fixture}" -P "${CMAKE_CURRENT_LIST_FILE}"
        RESULT_VARIABLE rejected OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(rejected EQUAL 0 OR NOT error MATCHES "does not match its locked source")
    message(FATAL_ERROR "A partially applied patch was accepted: ${output}${error}")
endif()
file(READ "${fixture}/second.txt" actual)
if(NOT actual STREQUAL "before\n")
    message(FATAL_ERROR "Partial patch probe modified the generated source")
endif()
set(pristine "${fixture}/pristine")
set(patches "${fixture}/patches")
file(MAKE_DIRECTORY "${pristine}" "${patches}")
file(WRITE "${pristine}/input.txt" "before\n")
file(WRITE "${patches}/create.patch" "--- a/input.txt\n+++ b/input.txt\n@@ -1 +1 @@\n-before\n+after\n--- /dev/null\n+++ b/created.txt\n@@ -0,0 +1 @@\n+created by patch\n")
PREPARE_SOURCE_TREE("${pristine}" "${patches}" "${fixture}/prepared" "enabled=ON" prepared)
APPLY_GIT_PATCH("${prepared}" "${patches}/create.patch")
file(WRITE "${prepared}/compiled-object.o" "keep compiled output")
PREPARE_SOURCE_TREE("${pristine}" "${patches}" "${fixture}/prepared" "enabled=ON" repeated)
if(NOT repeated STREQUAL prepared)
    message(FATAL_ERROR "Unchanged inputs lost their generated source identity")
endif()
APPLY_GIT_PATCH("${repeated}" "${patches}/create.patch")
file(READ "${repeated}/input.txt" actual)
if(NOT actual STREQUAL "after\n" OR NOT EXISTS "${repeated}/created.txt" OR NOT EXISTS "${repeated}/compiled-object.o")
    message(FATAL_ERROR "Repeated configure overwrote patched source or compiled output")
endif()
file(WRITE "${pristine}/input.txt" "new source\n")
PREPARE_SOURCE_TREE("${pristine}" "${patches}" "${fixture}/prepared" "enabled=ON" changed)
file(READ "${changed}/input.txt" actual)
if(changed STREQUAL prepared OR NOT actual STREQUAL "new source\n" OR EXISTS "${changed}/created.txt")
    message(FATAL_ERROR "Changed pristine input reused stale patched files")
endif()
PREPARE_SOURCE_TREE("${pristine}" "${patches}" "${fixture}/prepared" "enabled=OFF" disabled)
if(disabled STREQUAL changed)
    message(FATAL_ERROR "Changed patch selection reused the previous source tree")
endif()
file(APPEND "${patches}/create.patch" "\n")
PREPARE_SOURCE_TREE("${pristine}" "${patches}" "${fixture}/prepared" "enabled=OFF" repatched)
if(repatched STREQUAL disabled)
    message(FATAL_ERROR "Changed patch bytes reused the previous source tree")
endif()
message(STATUS "Source patch checks passed: strict patch validation and repeatable generated source preparation")
