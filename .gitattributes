* text=auto
*.go text eol=lf
*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf
*.sh text eol=lf
*.service text eol=lf
# Native build scripts and upstream configure inputs require LF even on Windows.
third_party/sunshine/** text=auto eol=lf
third_party/moonlight-android/** text=auto eol=lf
third_party/moonlight-android/*.bat text eol=crlf
# Distribution notice hashes cover exact upstream bytes, including jar-extracted CRLF.
third_party/moonlight-android/app/src/main/assets/licenses/** -text
# Go mod vendor copies module archive bytes, including upstream CRLF files.
# Preserve those bytes across checkouts so regeneration is identical on both OSes.
# Nested upstream attributes may re-enable text conversion; retain LF in that
# case, independently of the runner's native EOL and autocrlf configuration.
orchestrator/vendor/** -text eol=lf
# This locally replaced module is copied into vendor by the same command.
third_party/sevenzip/** -text
scripts/licenses/**/LICENSE* -text
# Pinned upstream notice hashes cover original bytes, including NOTICE files.
scripts/licenses/cargo/** -text
# Signed driver catalogs and inventory hashes require exact release bytes.
deploy/windows/usb-audio-driver/** -text whitespace=cr-at-eol
