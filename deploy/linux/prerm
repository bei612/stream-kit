#!/bin/sh
set -eu
# The single rendering owner is recorded by the unified installer, not guessed
# from logged-in sessions. Package removal preserves all application data.
case "${1:-}" in
  remove|upgrade|deconfigure)
    if [ -f /var/lib/stream-kit/render-user ]; then
      owner=$(cat /var/lib/stream-kit/render-user)
      uid=$(id -u "$owner")
      if [ -S "/run/user/$uid/bus" ]; then
        runuser -u "$owner" -- env XDG_RUNTIME_DIR="/run/user/$uid" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" systemctl --user stop stream-kit.service
        if [ "$1" = remove ]; then
          runuser -u "$owner" -- env XDG_RUNTIME_DIR="/run/user/$uid" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" systemctl --user disable stream-kit.service
        fi
      fi
    fi
    ;;
esac
