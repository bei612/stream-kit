[Unit]
Description=Stream-Kit unified rendering platform
After=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/opt/stream-kit/orchestrator
UMask=0077
ExecStartPre=/opt/stream-kit/orchestrator/orchestrator verify-bundle /opt/stream-kit/orchestrator
ExecStartPre=/opt/stream-kit/orchestrator/orchestrator check-config --config %h/.local/share/stream-kit/runtime/orchestrator.json
ExecStart=/opt/stream-kit/orchestrator/orchestrator --config %h/.local/share/stream-kit/runtime/orchestrator.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
KillMode=control-group

[Install]
WantedBy=default.target
